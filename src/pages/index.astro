---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LabelVoorbeeld from '@/components/LabelVoorbeeld.astro';
import { LABELS } from '@/data/labels';
import { mailto } from '@/config/site';
import { url } from '@/lib/url';

// Voorbeeldvragen onder het AIO-vraagveld in de opening; ze gaan naar AIO (de gids, src/scripts/aio-gids.ts).
const VOORBEELDEN = ['Wat doet AIO Plus?', 'Hoe krijg ik meer reviews?', 'Welk label past bij mijn zaak?'];
---
<BaseLayout
  title="AIO Plus: één AI-motor, vier labels"
  description="AIO Plus brengt Review Plus, View Plus, Website Plus en Tab Plus samen in één platform, met AIO als AI-laag die overal meedenkt. Powered by Claude."
>
  <a class="naar-inhoud" href="#labels">Naar de labels</a>
  <canvas id="heelal" aria-hidden="true"></canvas>

  <header>
    <a class="merk" href={url('/')} aria-label="AIO Plus, naar het begin">
      <svg width="20" height="21" viewBox="0 0 906 958" aria-hidden="true">
        <path d="M0 0H386V410A386 410 0 0 1 0 0Z" fill="#4F6BFF" /><path d="M520 0H906V410H520Z" fill="#C150FF" />
        <path d="M386 548V958H0A386 410 0 0 1 386 548Z" fill="#FF6A3D" /><path d="M520 548H906V958H520Z" fill="#3BDB7F" />
      </svg>
      AIO Plus
    </a>
    <nav class="hoofdmenu" aria-label="Hoofdmenu">
      {LABELS.map((l, i) => (
        <Fragment>
          {i === 2 && (
            <button type="button" class="aio-knop" aria-controls="aio-gids" aria-expanded="false" aria-label="AIO, je gids"><span>AIO</span></button>
          )}
          <button type="button" data-ga={l.id} aria-controls={`paneel-${l.id}`} style={`--k:${l.kleur}`}><i></i><span>{l.kort}<span class="plus"> Plus</span></span></button>
        </Fragment>
      ))}
    </nav>
    <a class="pil" href={mailto('Demo AIO Plus')}>Plan een demo</a>
  </header>

  <main>
    <!-- Opening: de boodschap, AIO en een demo in het eerste scherm (verbeterplan fase 2) -->
    <section class="opening" aria-labelledby="kop-opening">
      <div class="opening-inhoud">
        <p class="kicker"><span class="kicker-bol" aria-hidden="true"></span>Eén platform, één AI-laag, powered by Claude</p>
        <h1 id="kop-opening">Eén <span class="heel">AI-motor.</span> Vier gespecialiseerde labels.</h1>
        <p class="lead">Reviews, social media, je website en je kassa. Samen in één platform, met AIO die overal meedenkt.</p>

        <form class="vraag-aio" aria-label="Vraag het AIO">
          <span class="vraag-bol" aria-hidden="true">AIO</span>
          <label class="sr-only" for="vraag-aio-veld">Je vraag aan AIO</label>
          <input id="vraag-aio-veld" type="text" maxlength="1000" autocomplete="off" enterkeyhint="send" placeholder="Vraag AIO iets over AIO Plus" />
          <button type="submit" class="vraag-stuur" aria-label="Versturen">↑</button>
        </form>
        <div class="voorbeelden" aria-label="Voorbeeldvragen">
          {VOORBEELDEN.map((v) => <button type="button" class="voorbeeld">{v}</button>)}
        </div>

        <div class="opening-acties">
          <a class="knop-licht" href={mailto('Demo AIO Plus')}>Plan een demo</a>
          <a class="link-pijl" href="#labels">Bekijk de vier labels <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <!-- De vier labels als tabbladen met één kaart (verbeterplan fase 3) -->
    <section class="labels-sectie" id="labels" aria-labelledby="kop-labels" tabindex="-1">
      <div class="sectie-kop">
        <p class="kicker">De labels</p>
        <h2 id="kop-labels">Begin met één label, voeg er later een toe.</h2>
        <p class="lead">Elk label doet één ding goed. AIO werkt in alle vier mee.</p>
      </div>

      <div class="tabs" role="tablist" aria-label="Labels van AIO Plus">
        {LABELS.map((l, i) => (
          <button type="button" role="tab" class="tab" id={`tab-${l.id}`} aria-controls={`paneel-${l.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={l.id} style={`--k:${l.kleur}`}>
            <i aria-hidden="true"></i>{l.naam}<span class="tab-status">{l.status}</span>
          </button>
        ))}
      </div>

      {LABELS.map((l, i) => (
        <div class="label paneel" id={`paneel-${l.id}`} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-label={l.id} style={`--k:${l.kleur}`} hidden={i !== 0} tabindex="0">
          <div class="paneel-intro">
            <p class="paneel-kicker">{l.nr} · <span class="naam">{l.naam}</span> · {l.status}</p>
            <h3>{l.kop}</h3>
            <p class="paneel-tekst">{l.tekst}</p>
            <dl class="cijfers">
              {l.cijfers.map(([getal, tekst]) => <div><dt>{getal}</dt><dd>{tekst}</dd></div>)}
            </dl>
            <div class="paneel-acties">
              <a class="knop" href={l.actie.href}>{l.actie.label} →</a>
            </div>
          </div>
          <LabelVoorbeeld id={l.id} />
          <ol class="pijlers" aria-label={`Wat ${l.naam} doet`} style={`--n:${l.pijlers.length}`}>
            {l.pijlers.map(([titel, intro, punten], j) => (
              <li>
                <span class="pj-nr" aria-hidden="true">0{j + 1}</span>
                <h4>{titel}</h4>
                <p>{intro}</p>
                <ul>{punten.map((p) => <li>{p}</li>)}</ul>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="afsluiting" aria-labelledby="kop-afsluiting">
      <h2 id="kop-afsluiting">Benieuwd wat AIO Plus voor jouw zaak kan doen?</h2>
      <div class="opening-acties">
        <a class="knop-licht" href={mailto('Demo AIO Plus')}>Plan een demo</a>
      </div>
    </section>
  </main>

  <!-- AIO als gids: src/scripts/aio-gids.ts vult deze laag pas als hij nodig is -->
  <div id="aio-gids" class="aio-gids" hidden></div>

  <script>
    import '@/scripts/heelal';
    import '@/scripts/labels';
    import '@/scripts/aio-gids';
  </script>
</BaseLayout>
