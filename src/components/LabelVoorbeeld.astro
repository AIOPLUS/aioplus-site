---
/**
 * Een klein productscherm per label: wat AIO in dat label doet (verbeterplan fase 3, rechts in de kaart).
 * Wat AIO doet komt uit de brochure van AIO Plus (merk/): een reviewreactie, een social caption en websitetekst in
 * dezelfde toon, en een samenvatting van je maandcijfers. Grijze regels zijn plaatshouders: geen verzonnen reviews of cijfers.
 */
import type { LabelId } from '@/data/labels';

interface Props { id: LabelId }
const { id } = Astro.props;

const UITLEG: Record<LabelId, string> = {
  reviewplus: 'Voorbeeld: een nieuwe review op Google, met een reactie die AIO in jouw toon voorstelt.',
  viewplus: 'Voorbeeld: de contentkalender van deze week, met een caption die AIO in de toon van je merk schrijft.',
  websiteplus: 'Voorbeeld: een pagina in ontwerp, met tekst die AIO schrijft vanuit de zoekintentie van je klant.',
  tabplus: 'Voorbeeld: een bestelling via de QR-code aan tafel, en AIO die je maandcijfers samenvat.',
};
const AIO: Record<LabelId, { wat: string; knoppen: string[] }> = {
  reviewplus: { wat: 'stelt een reactie voor, in jouw toon', knoppen: ['Plaatsen', 'Aanpassen'] },
  viewplus: { wat: 'schrijft de caption, in de toon van je merk', knoppen: ['Goedkeuren', 'Aanpassen'] },
  websiteplus: { wat: 'schrijft de tekst vanuit de zoekintentie', knoppen: ['Overnemen'] },
  tabplus: { wat: 'vat je maand samen', knoppen: ['Bekijk het overzicht'] },
};
const DAGEN = ['ma', 'di', 'wo', 'do', 'vr', 'za', 'zo'];
const POSTS = [1, 3, 5];
const r = (b: number, h?: number) => `--b:${b}%${h ? `;--h:${h}px` : ''}`;
---
<figure class="vb" role="img" aria-label={UITLEG[id]}>
  {id === 'reviewplus' && (
    <Fragment>
      <div class="vb-balk"><span>Reviews</span><span class="vb-chip">Google</span></div>
      <div class="vb-blok">
        <div class="vb-rij"><span class="vb-avatar"></span><span class="r" style={r(34)}></span></div>
        <div class="vb-sterren">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6L1.4 7.8l6-.7z" /></svg>)}</div>
        <span class="r" style={r(92)}></span><span class="r" style={r(64)}></span>
      </div>
    </Fragment>
  )}
  {id === 'viewplus' && (
    <Fragment>
      <div class="vb-balk"><span>Contentkalender</span><span class="vb-chip">Deze week</span></div>
      <div class="vb-blok vb-week">
        {DAGEN.map((d, i) => (
          <div class="vb-dag"><span>{d}</span><span class={POSTS.includes(i) ? 'vb-post' : 'vb-leeg'}></span></div>
        ))}
      </div>
    </Fragment>
  )}
  {id === 'websiteplus' && (
    <Fragment>
      <div class="vb-balk">
        <span class="vb-adres"><svg viewBox="0 0 16 16"><path d="M4.5 7V5a3.5 3.5 0 0 1 7 0v2M3.5 7h9v7h-9z" /></svg><span class="r" style={r(100)}></span></span>
        <span class="vb-chip">Concept</span>
      </div>
      <div class="vb-blok vb-pagina">
        <span class="r vb-kop" style={r(78, 14)}></span><span class="r vb-kop" style={r(52, 14)}></span>
        <span class="r" style={r(60)}></span>
        <span class="vb-cta"></span>
        <div class="vb-tegels"><span></span><span></span><span></span></div>
      </div>
    </Fragment>
  )}
  {id === 'tabplus' && (
    <Fragment>
      <div class="vb-balk"><span>Tafel 4</span><span class="vb-chip">Besteld via QR</span></div>
      <div class="vb-blok vb-bon">
        {[[2, 46], [1, 58], [1, 38]].map(([n, b]) => <div class="vb-rij"><span class="vb-aantal">{n}×</span><span class="r" style={r(b)}></span></div>)}
        <span class="vb-keuken">Naar de keuken</span>
      </div>
    </Fragment>
  )}

  <div class="vb-aio">
    <p class="vb-aio-kop"><span class="vb-bol"></span><span><b>AIO</b> {AIO[id].wat}</span></p>
    <span class="r" style={r(96)}></span><span class="r" style={r(88)}></span><span class="r" style={r(48)}></span>
    <div class="vb-knoppen">{AIO[id].knoppen.map((k, i) => <span class={i === 0 ? 'vb-k1' : 'vb-k2'}>{k}</span>)}</div>
  </div>
</figure>
